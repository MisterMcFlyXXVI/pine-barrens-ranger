# Local development only. On Vercel these come from the Supabase integration or
# Project Settings -> Environment Variables. Copy to .env.local and fill in.
# Use the PUBLIC key (anon / publishable) -- never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
